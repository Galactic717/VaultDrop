{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VaultDrop",
  "mainBinaryName": "vaultdrop-gui",
  "version": "0.2.0",
  "identifier": "io.github.galactic717.vaultdrop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VaultDrop",
        "width": 1180,
        "height": 860,
        "minWidth": 760,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/vaultdrop"
    ],
    "shortDescription": "Offline verified backup",
    "longDescription": "Offline folder backups with read-back verification. Copies to one or two drives and checks existing backups for changed, missing or unreadable files.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Ukrainian",
          "Polish",
          "German",
          "Spanish",
          "French"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
